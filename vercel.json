{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "cleanUrls": true,
  "functions": {
    "api/extract.js": {
      "maxDuration": 10
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/workspace.js": {
      "maxDuration": 20
    },
    "api/monitor.js": {
      "maxDuration": 60
    },
    "api/analyze.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/monitor",
      "schedule": "0 8 * * *"
    }
  ]
}

