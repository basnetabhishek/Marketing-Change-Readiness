# Created automatically when the Supabase integration is connected in Vercel.
# Use only public/anonymous credentials here; never commit a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
POSTGRES_URL=
CRON_SECRET=
# Server-only Groq credential for Smart Scan. Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=
# Optional opt-in email delivery. In-app monitoring alerts work without these.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
PUBLIC_APP_URL=https://marketing-change-readiness.vercel.app
